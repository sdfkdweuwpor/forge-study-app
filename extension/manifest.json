{
  "manifest_version": 3,
  "name": "Forge Focus",
  "version": "1.0.0",
  "description": "Blocks distracting sites while you study. Works with the Forge app and keeps working when it is closed.",
  "key": "",
  "permissions": ["declarativeNetRequest", "storage", "alarms"],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "js/background/sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "Forge Focus",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://sdfkdweuwpor.github.io/*",
      "https://forge-study-app.netlify.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
